{
  "name": "station-age",
  "version": "1.0.0",
  "description": "Discord command that estimates the age of a station in Eve Online",
  "private": true,
  "license": "MIT",
  "author": "MrManiak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrManiak/station-age.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx src/deployCommands.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
